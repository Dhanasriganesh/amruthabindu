# WhatsApp
VITE_WHATSAPP_PHONE=918142554488

# Nimbuspost (delivery & tracking)
# Set NIMBUSPOST_ENABLED=false to skip shipping API calls (e.g. while testing payments)
# Nimbuspost (delivery & tracking)
NIMBUSPOST_ENABLED=true
NIMBUSPOST_API_EMAIL=amruthabindutnd+4384@gmail.com
NIMBUSPOST_API_PASSWORD=c1LDiUInaA
NIMBUSPOST_PICKUP_PINCODE=500049
# Optional — Nimbuspost usually does not show this in the panel; leave blank and use pickup address fields below
NIMBUSPOST_PICKUP_ADDRESS_ID=
# Warehouse / pickup details (must match Nimbuspost → Settings → Warehouse)
NIMBUSPOST_PICKUP_WAREHOUSE_NAME=Amrutha Bindu
NIMBUSPOST_PICKUP_CONTACT_NAME=Amrutha Bindu
NIMBUSPOST_PICKUP_ADDRESS=your full warehouse address line
NIMBUSPOST_PICKUP_CITY=Hyderabad
NIMBUSPOST_PICKUP_STATE=Telangana
NIMBUSPOST_PICKUP_PHONE=8142554488
NIMBUSPOST_DEFAULT_WEIGHT=0.5
NIMBUSPOST_DEFAULT_LENGTH=10
NIMBUSPOST_DEFAULT_BREADTH=10
NIMBUSPOST_DEFAULT_HEIGHT=10
NIMBUSPOST_MIN_WEIGHT=0.5
SHIPPING_RATE_MODE=recommended

# Optional: free delivery above this order value (₹). Leave empty or 0 to always charge Nimbuspost rate.
# FREE_SHIPPING_MIN_ORDER=999
# How to pick the checkout delivery fee: recommended or cheapest
SHIPPING_RATE_MODE=recommended
# Minimum billable package weight in kg (0.5 kg slabs)
NIMBUSPOST_MIN_WEIGHT=0.5
# Optional: add flat ₹ markup on top of the selected courier rate
# SHIPPING_MARKUP=0

PORT=3001

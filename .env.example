# Amrutha Bindu — environment variables

# Firebase (client — Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server API routes — Nimbuspost sync, tracking)
# Option A: full service account JSON (one line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B: separate fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Site branding
VITE_SITE_URL=https://amruthabindu.in
VITE_CONTACT_EMAIL=amruthabindutnd@gmail.com
VITE_SUPPORT_EMAIL=amruthabindutnd@gmail.com

# Razorpay (server — never expose KEY_SECRET to the client)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay (client — key ID only)
VITE_RAZORPAY_KEY_ID=
# Legacy alias (optional)
# VITE_RZP_KEY_ID=
# VITE_RZP_PAYMENT_PAGE_URL=

# Admin panel — comma-separated Firebase Auth emails allowed to access /admin
VITE_ADMIN_EMAILS=admin@amruthabindu.in

# Email (SMTP)
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
